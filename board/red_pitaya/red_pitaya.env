arch=arm
board=zynq
board_name=zynq
bootm_low=0
bootm_size=20000000
cpu=armv7
modeboot=sdboot
soc=zynq
loadaddr=0x0
script_offset_f=fc0000
scriptaddr=0
bootcmd=run $modeboot
bootdelay=3
baudrate=115200
ipaddr=10.10.70.102
serverip=10.10.70.101
prod_date=01/01/13
kernel_image=uImage
ramdisk_image=uramdisk.image.g
devicetree_image=devicetree.dtb
bitstream_image=system.bit.bin
loadbit_addr=0x100000
kernel_size=0x500000
devicetree_size=0x20000
ramdisk_size=0x5E0000
fdt_high=0x20000000
initrd_high=0x20000000
sdboot=echo Running script from SD... && mmcinfo && fatload mmc 0 0x2000000 u-boot.scr && source 0x2000000
qspiboot=echo Running script from QSPI... && mmcinfo && fatload mmc 0 0x2000000 u-boot.scr && source 0x2000000
ethaddr=88:88:88:88:88:88
nav_code=0
hw_rev=0
serial=0